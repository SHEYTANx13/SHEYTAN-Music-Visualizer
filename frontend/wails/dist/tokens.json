{
  "$schema": "https://sheytan.dev/schemas/design-tokens.v1.json",
  "schemaVersion": 1,
  "product": "SHEYTAN Music Visualizer",
  "identity": "BETA",
  "description": "Canonical framework-independent design tokens for SHEYTAN Music Visualizer. Single source of truth consumed by the native Go-Gui (Gio) shell and the Wails v3 web shell. Values derive from internal/brand identity constants; new semantic/accessibility tokens are additive and documented in docs/DESIGN-SYSTEM.md.",
  "color": {
    "surface": {
      "obsidian": "#080808",
      "deepCharcoal": "#111111",
      "volcanic": "#190909"
    },
    "accent": {
      "darkBlood": "#9F0B18",
      "infernalRed": "#D51D2A",
      "emberHighlight": "#FF453A",
      "hotEmber": "#FF7043"
    },
    "secondary": {
      "antiqueGold": "#B98A3E"
    },
    "text": {
      "primary": "#F2EEEE",
      "secondary": "#A9A0A0"
    },
    "line": {
      "divider": "#342020"
    },
    "status": {
      "success": "#4CAF6E",
      "warning": "#D9A441",
      "error": "#E6402F",
      "info": "#A9A0A0"
    }
  },
  "typography": {
    "familyStack": ["system-ui", "Noto Sans", "Segoe UI", "Roboto", "sans-serif"],
    "scale": {
      "display": { "size": 28, "weight": 600 },
      "title": { "size": 20, "weight": 600 },
      "heading": { "size": 16, "weight": 600 },
      "body": { "size": 14, "weight": 400 },
      "caption": { "size": 12, "weight": 400 }
    }
  },
  "spacing": {
    "unit": 4,
    "steps": [4, 8, 12, 16, 24, 32, 48]
  },
  "radius": {
    "sm": 4,
    "md": 8,
    "lg": 12,
    "pill": 999
  },
  "elevation": {
    "level0": { "shadowOpacity": 0.0 },
    "level1": { "shadowOpacity": 0.25, "tint": "#000000" },
    "level2": { "shadowOpacity": 0.4, "tint": "#000000", "glowTint": "#9F0B18", "glowOpacity": 0.12 }
  },
  "motion": {
    "durationMs": { "fast": 120, "base": 200, "slow": 320 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.3, 0, 0, 1)"
    },
    "reducedMotion": false,
    "reducedGlow": false
  },
  "decoration": {
    "magicCircleRings": 3,
    "orbitNodes": 8,
    "runeMarks": true,
    "radialLight": true,
    "maxDecorationOpacity": 0.16,
    "maxGlowStrength": 0.6,
    "embers": true,
    "note": "Original concentric circles, radial geometry and fictional rune-like marks only; never protected logos or insignia. Decoration is always a low-opacity backdrop and must never obscure timelines, waveforms, text or controls."
  },
  "intensityPresets": {
    "subtle": { "decorationOpacity": 0.05, "glowStrength": 0.15, "embers": false },
    "ritual": { "decorationOpacity": 0.1, "glowStrength": 0.35, "embers": true },
    "infernal": { "decorationOpacity": 0.16, "glowStrength": 0.6, "embers": true }
  },
  "defaultIntensity": "ritual",
  "breakpoints": {
    "phone": { "maxDp": 599, "layout": "stacked", "touchTargetMinDp": 48 },
    "tablet": { "minDp": 600, "maxDp": 959, "layout": "stacked-wide", "touchTargetMinDp": 48 },
    "desktop": { "minDp": 960, "layout": "split", "touchTargetMinDp": 32 },
    "wide": { "minDp": 1680, "layout": "split-capped", "contentCapDp": 1680 }
  },
  "accessibility": {
    "focusRing": { "color": "#FF453A", "widthDp": 2, "offsetDp": 2 },
    "minContrastBody": 4.5,
    "minContrastLarge": 3.0,
    "contrastPairs": [
      { "foreground": "#F2EEEE", "background": "#080808", "ratio": 16.3 },
      { "foreground": "#A9A0A0", "background": "#080808", "ratio": 7.6 },
      { "foreground": "#F2EEEE", "background": "#9F0B18", "ratio": 6.9 },
      { "foreground": "#FF453A", "background": "#080808", "ratio": 5.0 },
      { "foreground": "#B98A3E", "background": "#080808", "ratio": 5.6 }
    ],
    "screenReader": {
      "announceTransportChanges": true,
      "announceDownloadChanges": true,
      "tabOrderFollowsNavigationOrder": true
    }
  }
}
