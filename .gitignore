# Go build and test artifacts
/bin/
/dist/
ci-parts/
*.test
*.out
*.prof

# Local CI logs (the packaged evidence log is committed explicitly)
/ci-logs/

# Local toolchains and editor state
/.toolchain/
.idea/
.vscode/

# Windows resource object (generated by build-windows.ps1 via windres;
# never committed - a bare .syso would be linked into every platform).
cmd/app-gogui/resource.syso
__pycache__/

# Cross-compile outputs (go build with GOOS=windows writes *.exe to cwd)
/*.exe

# Full-tree go build outputs (go build ./... writes main-package
# binaries named after their package directory into the cwd)
/app-wails
/app-gogui
/sheytan-music-visualizer
/ci-log-collector
/cisanitize
/timedrun
/civalidate
